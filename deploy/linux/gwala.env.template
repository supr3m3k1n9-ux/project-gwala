# Project Gwala Ubuntu VPS shadow-mode environment.
# Copy to /etc/project-gwala/gwala.env and fill in real secrets on the VPS only.
# Do not commit the filled environment file.

GWALA_PROJECT_ROOT=/opt/project-gwala
GWALA_DATA_DIR=/opt/project-gwala/data
GWALA_PYTHON=/opt/project-gwala/.venv-webull/bin/python
GWALA_SERVICE_LOG_DIR=/var/log/project-gwala
GWALA_DASHBOARD_HOST=127.0.0.1
GWALA_DASHBOARD_PORT=8765
GWALA_HOST_SYSTEMD_HEALTH_JSON=/opt/project-gwala/logs/host_systemd_health.json

# Required safety posture for VPS migration.
GWALA_DEPLOYMENT_MODE=shadow
GWALA_SHADOW_MODE=true
GWALA_DISABLE_BROKER_EXECUTION=true
GWALA_LIVE_TRADING_ENABLED=false
GWALA_BROKER_ORDER_EXECUTION_ENABLED=false
GWALA_REAL_MONEY_READY=false

# Webull OpenAPI data-only credentials.
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here
WEBULL_REGION_ID=us
WEBULL_API_ENDPOINT=

# Optional Polygon market-data API key for Polygon tools.
POLYGON_API_KEY=paste_your_polygon_api_key_here

# Email delivery is intentionally disabled for this Linux layer until configured separately.
GWALA_EMAIL_ENABLED=false
GWALA_SMTP_HOST=smtp.gmail.com
GWALA_SMTP_PORT=587
GWALA_SMTP_USE_STARTTLS=true
GWALA_SMTP_USERNAME=
GWALA_SMTP_PASSWORD=
GWALA_EMAIL_FROM=
GWALA_EMAIL_TO=
GWALA_SMTP_TIMEOUT_SECONDS=20
