[Unit]
Description=Project Gwala production alert - Docker shadow
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/python3 /srv/projects/gwala/app/deploy/linux/write_host_systemd_health.py --output /srv/projects/gwala/logs/host_systemd_health.json
ExecStart=/srv/projects/gwala/run_in_docker.sh python run_production_alert.py --output-dir logs --data-dir /app/runtime_data --interval-minutes 5 --cooldown-minutes 30 --recheck-seconds 25 --outage-threshold-minutes 5 --down-confirmation-failures 2
