[Unit]
Description=Project Gwala End-of-Day Executive Report - Docker shadow
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/srv/projects/gwala/run_in_docker.sh python run_executive_report.py --report-type eod --output-dir logs --data-dir /app/runtime_data --reports-dir logs/executive_reports --deliver
