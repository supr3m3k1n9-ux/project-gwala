[Unit]
Description=Project Gwala autonomous paper workflow shadow run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/project-gwala/gwala.env
WorkingDirectory=/opt/project-gwala
ExecStart=/bin/bash -lc 'cd "$GWALA_PROJECT_ROOT" && exec "$GWALA_PYTHON" run_autonomous_paper_workflow.py --interval-minutes 5 --auto-confirm-paper-exits --once'
NoNewPrivileges=true
PrivateTmp=true
