[Unit]
Description=Project Gwala dashboard - Docker shadow
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/projects/gwala
Environment=GWALA_APP_DIR=/srv/projects/gwala/app
Environment=GWALA_STACK_DIR=/srv/projects/gwala
ExecStart=/usr/bin/docker compose -f /srv/projects/gwala/compose.yaml up --no-build gwala
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
