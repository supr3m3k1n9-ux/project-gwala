[Unit]
Description=Project Gwala dashboard - Docker shadow
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/srv/projects/gwala/run_in_docker.sh python run_app.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
