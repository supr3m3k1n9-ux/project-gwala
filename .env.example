# Copy this file to .env and replace placeholders with your real Webull values.
# Never commit real API keys or secrets.

WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here
WEBULL_REGION_ID=us
WEBULL_API_ENDPOINT=

# Polygon market data API key.
POLYGON_API_KEY=paste_your_polygon_api_key_here

# Executive report email delivery.
# For Gmail, enable 2-Step Verification and use a Gmail App Password here.
GWALA_EMAIL_ENABLED=false
GWALA_SMTP_HOST=smtp.gmail.com
GWALA_SMTP_PORT=587
GWALA_SMTP_USE_STARTTLS=true
GWALA_SMTP_USERNAME=your_gmail_address@gmail.com
GWALA_SMTP_PASSWORD=your_gmail_app_password_here
GWALA_EMAIL_FROM=your_gmail_address@gmail.com
GWALA_EMAIL_TO=recipient@example.com
GWALA_SMTP_TIMEOUT_SECONDS=20
